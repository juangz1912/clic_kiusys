# Copiar a scripts/oci/oci.env (no commitear) y completar valores.
# Región ejemplo Colombia: sa-bogota-1 | Ashburn: us-ashburn-1

OCI_REGION=sa-bogota-1
OCIR_NAMESPACE=axxxxxxxxxxx
OCIR_USERNAME=axxxxxxxxxxx/oracleidentitycloudservice/tu_usuario
OCIR_AUTH_TOKEN=PEGAR_TOKEN_AQUI
OCIR_REPO=clic-kiusys
OCIR_MOCKS_REPO=clic-kiusys-mocks
IMAGE_TAG=v2.0.0

OKE_CLUSTER_ID=ocid1.cluster.oc1.region.aaaa...
KUBECONFIG_CONTEXT=

# Vacío = Postgres en cluster (k8s/postgres.yaml) + mocks internos
DATABASE_URL=
API_B_BASE_URL=
API_C_BASE_URL=
API_B_ENTITY_PATH=/api/mascotas
API_C_ENTITY_PATH=/api/items
INTEGRATION_STUB_WHEN_UNREACHABLE=true

# Object Storage OCI (Integrante A)
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaa...
OCI_OS_NAMESPACE=axxxxxxxxxxx
OCI_OS_BUCKET=clic-kiusys-flow
OCI_OS_REGION=sa-bogota-1
OCI_S3_ACCESS_KEY_ID=
OCI_S3_SECRET_ACCESS_KEY=
PUBLIC_API_BASE_URL=http://IP-LB-OCI
OBJECT_STORAGE_BACKEND=oci
