# Copiar a scripts/oci/oci.env (no commitear) y completar valores.
# Región ejemplo Colombia: sa-bogota-1 | Ashburn: us-ashburn-1

OCI_REGION=sa-bogota-1
OCIR_NAMESPACE=axxxxxxxxxxx
OCIR_USERNAME=axxxxxxxxxxx/oracleidentitycloudservice/tu_usuario
OCIR_AUTH_TOKEN=PEGAR_TOKEN_AQUI
OCIR_REPO=clic-kiusys
IMAGE_TAG=v2.0.0

OKE_CLUSTER_ID=ocid1.cluster.oc1.region.aaaa...
KUBECONFIG_CONTEXT=

DATABASE_URL=postgresql://user:pass@host:5432/pss_produccion
API_B_BASE_URL=
API_C_BASE_URL=
API_B_ENTITY_PATH=/api/mascotas
API_C_ENTITY_PATH=/api/items
INTEGRATION_STUB_WHEN_UNREACHABLE=true
