ENVIRONMENT=pruebas
DATABASE_URL=postgresql://pss:pss@localhost:5433/pss_pruebas
HOLD_MINUTES=10

# Seguimiento #2 — multicloud (Integrante A / OCI)
CLOUD_PROVIDER=oci
OKE_CLUSTER_NAME=clic-kiusys-oke
API_B_BASE_URL=
API_B_ENTITY_PATH=/api/mascotas
API_C_BASE_URL=
API_C_ENTITY_PATH=/api/items
INTEGRATION_TIMEOUT_SECONDS=10
INTEGRATION_STUB_WHEN_UNREACHABLE=true
OBSERVABILITY_SAAS_URL=

# Object Storage (Integrante A / OCI) — local en dev; oci en OKE con Customer Secret Key
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_DIR=./data/object-storage
OCI_OS_NAMESPACE=
OCI_OS_BUCKET=clic-kiusys-flow
OCI_OS_REGION=sa-bogota-1
OCI_S3_ACCESS_KEY_ID=
OCI_S3_SECRET_ACCESS_KEY=
PUBLIC_API_BASE_URL=http://localhost:8001
