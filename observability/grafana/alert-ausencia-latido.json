{
  "uid": "clic-ausencia-latido",
  "title": "API A - ausencia de latido",
  "ruleGroup": "clic-s2",
  "condition": "C",
  "for": "30s",
  "noDataState": "Alerting",
  "execErrState": "Error",
  "labels": { "severity": "critical", "equipo": "multicloud-s2", "capa": "deteccion" },
  "annotations": {
    "summary": "clic-kiusys-api dejo de enviar la serie del latido",
    "description": "No es una alerta de errores 5xx. Si no hay datos, la telemetria esta ciega."
  },
  "data": [
    {
      "refId": "A",
      "datasourceUid": "grafanacloud-prom",
      "relativeTimeRange": { "from": 300, "to": 0 },
      "model": {
        "refId": "A",
        "expr": "sum(increase(http_server_requests_total{service_name=\"clic-kiusys-api\"}[2m]))",
        "instant": true,
        "intervalMs": 1000,
        "maxDataPoints": 43200
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": { "refId": "B", "type": "reduce", "expression": "A", "reducer": "last" }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [ { "evaluator": { "type": "lt", "params": [0] } } ]
      }
    }
  ]
}
