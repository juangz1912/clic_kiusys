#cloud-config
package_update: true
packages:
  - podman
  - python3
  - python3-pip
  - python3-devel
  - gcc
write_files:
  - path: /opt/clic-kiusys/api.env
    owner: root:root
    permissions: "0600"
    content: |
      DATABASE_URL=postgresql://pss:${db_password}@127.0.0.1:5432/pss_produccion
      ENVIRONMENT=produccion
      CLOUD_PROVIDER=oci
      OKE_CLUSTER_NAME=vm-a1-flex
      OBJECT_STORAGE_BACKEND=oci
      OCI_OS_NAMESPACE=${namespace}
      OCI_OS_BUCKET=${bucket}
      OCI_OS_REGION=${region}
      OCI_S3_ACCESS_KEY_ID=${s3_access_key}
      OCI_S3_SECRET_ACCESS_KEY=${s3_secret_key}
      DEMO_FAILURE_ENABLED=false
  - path: /etc/systemd/system/clic-postgres.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=PostgreSQL de Clic KiuSys
      After=network-online.target
      Wants=network-online.target

      [Service]
      Restart=always
      RestartSec=5
      TimeoutStartSec=120
      ExecStartPre=-/usr/bin/podman rm -f postgres
      ExecStart=/usr/bin/podman run --name postgres --rm -p 127.0.0.1:5432:5432 -v /var/lib/clic-pg:/var/lib/postgresql/data:Z -e POSTGRES_USER=pss -e POSTGRES_PASSWORD=${db_password} -e POSTGRES_DB=pss_produccion docker.io/library/postgres:16-alpine
      ExecStop=/usr/bin/podman stop -t 20 postgres

      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/clic-api.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=API Clic KiuSys
      After=network-online.target clic-postgres.service
      Wants=network-online.target

      [Service]
      WorkingDirectory=/opt/clic-kiusys
      EnvironmentFile=/opt/clic-kiusys/api.env
      ExecStart=/opt/clic-kiusys/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
      Restart=always
      RestartSec=3

      [Install]
      WantedBy=multi-user.target
runcmd:
  - systemctl disable --now firewalld || true
  - mkdir -p /var/lib/clic-pg /opt/clic-kiusys
  - for i in 1 2 3 4 5 6; do /usr/bin/podman pull docker.io/library/postgres:16-alpine && break; sleep 20; done
  - python3 -m pip install --upgrade pip || true
  - systemctl daemon-reload
  - systemctl enable --now clic-postgres.service
